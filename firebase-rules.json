{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "public": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "values": {
          "level": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
          },
          "xp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "achievements": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
          },
          "best-streak": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "games": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "correct": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
          },
          "route-won": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "size-best": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
          },
          "decide-best": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
          },
          "geodle-won": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "conn-won": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "distance-best": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
          },
          "chain-best": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
          },
          "blitz-flags": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
          },
          "blitz-capitals": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
          },
          "blitz-outlines": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
          }
        },
        "dailyTotal": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
        },
        "yesterdayTotal": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
        },
        "monthPoints": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9300"
        },
        "lastMonthPoints": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9300"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "favorites": {
          "$achievementId": {
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "matches": {
      ".read": "auth != null",
      "$matchId": {
        ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists())",
        "players": {
          "$playerId": {
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "time": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
            }
          }
        }
      }
    },
    "inbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$matchId": {
          ".write": "auth != null"
        }
      }
    },
    "names": {
      ".read": true,
      "$nameKey": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    }
  }
}
